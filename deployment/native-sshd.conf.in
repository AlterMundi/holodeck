# Only for existing sshd's stdio (-i) mode through an authorized fixed operator
# command. No listener, normal SSH config/account change or private key copy.
HostKey @EXISTING_HOST_PRIVATE_KEY_PATH@
AuthorizedKeysFile @SELECTED_OPERATOR_PUBLIC_KEY_FILE@
StrictModes yes
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
PubkeyAuthentication yes
AllowUsers root
# OpenSSH's permission setup couples this flag to Unix forwarding. The exact
# Unix path below and PermitListen none deny real TCP forwarding in both ways.
AllowTcpForwarding yes
PermitOpen [@EXACT_NATIVE_BRIDGE_SOCKET@]:*
PermitListen none
AllowStreamLocalForwarding yes
AllowAgentForwarding no
X11Forwarding no
PermitTTY no
PermitTunnel no
ForceCommand /usr/bin/false
MaxSessions 0
StreamLocalBindMask 0117
StreamLocalBindUnlink yes
LogLevel ERROR
LoginGraceTime 30
